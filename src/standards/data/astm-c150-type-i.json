  "standardVersion": "ASTM C150-22 Type I",
  "defaultMarginPct": 5,
  "limits": [
    {
      "parameter": "CaO",
      "path": "oxides.CaO",
      "op": "between",
      "min": 60.0,
      "max": 67.0,
      "unit": "%",
      "group": "chemical",
      "required": true,
      "limitLabel": "60.0 – 67.0",
      "notes": "Process control band for Type I OPC (no CaO limit in ASTM C150 Table 1 for Type I)"
    },
    {
      "parameter": "SiO2",
      "path": "oxides.SiO2",
      "op": "between",
      "min": 18.0,
      "max": 24.0,
      "unit": "%",
      "group": "chemical",
      "required": true,
      "limitLabel": "18.0 – 24.0",
      "notes": "Process control band for Type I OPC (no SiO2 limit in ASTM C150 Table 1 for Type I)"
    },
    {
      "parameter": "Al2O3",
      "path": "oxides.Al2O3",
      "op": "between",
      "min": 3.0,
      "max": 8.0,
      "unit": "%",
      "group": "chemical",
      "required": true,
      "limitLabel": "3.0 – 8.0",
      "notes": "Process control band for Type I OPC (no Al2O3 limit in ASTM C150 Table 1 for Type I; Type II max is 6.0%)"
    },
    {
      "parameter": "Fe2O3",
      "path": "oxides.Fe2O3",
      "op": "between",
      "min": 1.5,
      "max": 4.5,
      "unit": "%",
      "group": "chemical",
      "required": true,
      "limitLabel": "1.5 – 4.5",
      "notes": "Process control band for Type I OPC (no Fe2O3 limit in ASTM C150 Table 1 for Type I; Type II max is 6.0%)"
    },
    {
      "parameter": "MgO",
      "path": "oxides.MgO",
      "op": "max",
      "value": 6.0,
      "unit": "%",
      "group": "chemical",
      "required": true,
      "limitLabel": "<= 6.0",
      "notes": "ASTM C150-22 Table 1"
    },
    {
      "parameter": "SO3",
      "path": "oxides.SO3",
      "op": "max",
      "unit": "%",
      "group": "chemical",
      "required": true,
      "notes": "ASTM C150-22 Table 1 — SO3 ceiling depends on Bogue C3A",
      "conditional": [
        {
          "whenPath": "bogue.C3A",
          "whenOp": "lte",
          "whenValue": 8,
          "value": 3.0,
          "limitLabel": "<= 3.0 (C3A <= 8%)"
        },
        {
          "whenPath": "bogue.C3A",
          "whenOp": "gt",
          "whenValue": 8,
          "value": 3.5,
          "limitLabel": "<= 3.5 (C3A > 8%)"
        }
      ]
    },
    {
      "parameter": "LOI",
      "path": "oxides.LOI",
      "op": "max",
      "value": 3.0,
      "unit": "%",
      "group": "chemical",
      "required": true,
      "limitLabel": "<= 3.0",
      "notes": "ASTM C150-22 Table 1 when limestone is not an ingredient (3.5% max when limestone is an ingredient)"
    },
    {
      "parameter": "IR",
      "path": "oxides.IR",
      "op": "max",
      "value": 1.5,
      "unit": "%",
      "group": "chemical",
      "required": true,
      "limitLabel": "<= 1.5",
      "notes": "ASTM C150-22 Table 1"
    },
    {
      "parameter": "freeLime",
      "path": "oxides.freeLime",
      "op": "max",
      "value": 1.5,
      "unit": "%",
      "group": "chemical",
      "required": true,
      "limitLabel": "<= 1.5",
      "notes": "Plant/process control band (not a numbered ASTM C150 Type I Table 1 limit)"
    },
    {
      "parameter": "LSF",
      "path": "ratios.LSF",
      "op": "between",
      "min": 0.92,
      "max": 0.98,
      "unit": "-",
      "group": "process",
      "required": true,
      "limitLabel": "0.92 – 0.98",
      "notes": "Process control band for kiln feed / clinker (not an ASTM C150 Table 1 limit)"
    },
    {
      "parameter": "SR",
      "path": "ratios.SR",
      "op": "between",
      "min": 2.0,
      "max": 3.0,
      "unit": "-",
      "group": "process",
      "required": true,
      "limitLabel": "2.0 – 3.0",
      "notes": "Process control band — silica modulus (not an ASTM C150 Table 1 limit)"
