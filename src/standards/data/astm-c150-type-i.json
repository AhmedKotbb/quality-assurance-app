      "max": 105.0,
      "unit": "%",
      "group": "process",
      "required": true,
      "limitLabel": "95.0 – 105.0",
      "notes": "Plausibility band for reported oxide analysis sum (not an ASTM C150 Table 1 limit)"
    },
    {
      "parameter": "C3S",
      "path": "bogue.C3S",
      "op": "min",
      "value": 45.0,
      "unit": "%",
      "group": "phases",
      "required": true,
      "limitLabel": ">= 45.0",
      "notes": "Advisory early-strength process band (no C3S limit in ASTM C150 Table 1 for Type I)"
    },
    {
      "parameter": "C2S",
      "path": "bogue.C2S",
      "op": "between",
      "min": 5.0,
      "max": 30.0,
      "unit": "%",
      "group": "phases",
      "required": true,
      "limitLabel": "5.0 – 30.0",
      "notes": "Advisory Type I process band (no C2S limit in ASTM C150 Table 1 for Type I; Type IV min is 40%)"
    },
    {
      "parameter": "C3A",
      "path": "bogue.C3A",
      "op": "max",
      "value": 15.0,
      "unit": "%",
      "group": "phases",
      "required": true,
      "limitLabel": "<= 15.0",
      "notes": "Advisory Type I process band (no C3A limit in ASTM C150 Table 1 for Type I; Type III max is 15%)"
    },
    {
      "parameter": "C4AF",
      "path": "bogue.C4AF",
      "op": "between",
      "min": 5.0,
      "max": 15.0,
      "unit": "%",
      "group": "phases",
      "required": true,
      "limitLabel": "5.0 – 15.0",
      "notes": "Advisory Type I process band (no C4AF limit in ASTM C150 Table 1 for Type I)"
    }
